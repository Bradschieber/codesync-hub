{
  "name": "Admin Alert: New Builder Profile",
  "description": "Sends the admin an SMS when a new builder (seller) profile is created.",
  "trigger": {
    "condition": "${ (.trigger.data.is_seller == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "UserProfile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "admin_alert_new_builder_profile",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAdminNewBuilder",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyAdminNewBuilder"
  }
}